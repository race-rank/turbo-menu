rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // isSignedIn() is TRUE for anonymous users - request.auth is non-null for them.
    // This is load-bearing: it lets guests create and track orders under rules that
    // never allow a fully unauthenticated write.
    function isSignedIn() { return request.auth != null; }

    // .get() with a default, not .admin: a bare property access RAISES on tokens
    // without the claim. Outcomes happen to be correct today, but any negation
    // (!isAdmin(), isAdmin() == false, a ternary) would then deny instead of
    // allow, and every ordinary denial logs "Property admin is undefined".
    function isAdmin()    { return request.auth != null && request.auth.token.get('admin', false) == true; }
    // .get() with defaults rather than a bare property access, which RAISES on
    // orders written in the pre-uid shape rather than evaluating to false. The
    // denial was always correct; it just arrived as an error. The create rule
    // was made tolerant for this reason already - the read path was missed.
    // Safe because Firebase Auth never issues a token with an empty sub, so the
    // '' default can never accidentally match request.auth.uid.
    function ownsOrder() {
      return resource.data.get('customerInfo', {}).get('uid', '') == request.auth.uid;
    }

    // Anonymous guests never get a profiles document, so any write that is
    // effectively "I have a profile" - an invite code, a friendship - must
    // refuse them. .get() with a default rather than a bare token access,
    // which RAISES for a provider that omits the claim entirely (this
    // project has already been bitten by that shape of bug - see isAdmin()).
    function isRealAccount() {
      return request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous';
    }

    // pairId is the two uids sorted ascending and joined with '_', so a rule can
    // derive the friendship document key from the two participants rather than
    // needing it passed in and then trusting it.
    function friendPairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function friendshipPath(owner) {
      return /databases/$(database)/documents/friendships/$(friendPairId(request.auth.uid, owner));
    }

    // exists() before get(): get() on a missing document raises rather than
    // returning null, and a raise inside a helper denies the read for a reason
    // that has nothing to do with friendship.
    function sharesFriendshipWith(owner) {
      return request.auth != null
        && request.auth.uid != owner
        && exists(friendshipPath(owner));
    }

    function isFriendOf(owner) {
      return sharesFriendshipWith(owner)
        && get(friendshipPath(owner)).data.status == 'accepted';
    }

    function claimPath(anonUid) {
      return /databases/$(database)/documents/accountClaims/$(anonUid);
    }

    // True once the caller has proved possession of a guest device's secret by
    // taking its claim - see match /accountClaims below. This is the ONLY thing
    // that lets one uid's data move to another.
    //
    // exists() before get() for the same reason sharesFriendshipWith() does it:
    // get() on a missing document raises rather than returning null, and a raise
    // inside a helper denies for a reason that has nothing to do with claiming.
    // The empty-string guard is load-bearing too, not cosmetic: interpolating an
    // empty segment into a path raises, and the callers below deliberately reach
    // customerInfo.uid through .get() defaults because pre-uid orders have no
    // uid at all (see ownsOrder()).
    function hasClaimOn(anonUid) {
      return request.auth != null
        && anonUid != ''
        && exists(claimPath(anonUid))
        && get(claimPath(anonUid)).data.get('claimedBy', '') == request.auth.uid;
    }

    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // match /users/{uid} above is NOT recursive, so these subcollections need
    // their own blocks. They are the friend-readable projection of a customer's
    // taste; the user document itself stays owner-only.
    match /users/{uid}/favorites/{comboId} {
      // hasClaimOn: a customer who signed in to a pre-existing account cannot
      // keep the guest uid, so the only way their guest favourites survive is
      // for the new account to read them and copy them across. Read and delete
      // only - the copy is written into the claimer's OWN subcollection, so
      // create/update below stay strictly owner-only.
      allow read: if isSignedIn()
        && (request.auth.uid == uid || isFriendOf(uid) || hasClaimOn(uid));
      // Split from delete because request.resource is null on a delete, so a
      // field check in a combined `write` would raise and deny legitimate ones.
      allow create, update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
             'comboId', 'label', 'kind', 'mixId', 'hookahId', 'tobaccoType',
             'flavorIds', 'tobaccoStrength', 'flavorPercentages', 'withIce',
             'hasLED', 'hasColoredWater', 'hasAlcohol', 'hasFruits', 'createdAt'])
        // Bound what a friend downloads: this list is re-read on every visit to
        // their profile. Same reasoning as the profiles block above.
        && request.resource.data.label is string
        && request.resource.data.label.size() <= 200
        // comboId is `mix:{docId}` or `custom:{16 hex}` - see comboId.ts -
        // never anywhere near this bound. Left unconstrained, this is the
        // same 700KB-string hole label had, just on the field next to it.
        && request.resource.data.comboId is string
        && request.resource.data.comboId.size() <= 100
        && request.resource.data.kind in ['mix', 'custom']
        && (!('mixId' in request.resource.data)
            || (request.resource.data.mixId is string
                && request.resource.data.mixId.size() <= 100))
        && (!('hookahId' in request.resource.data)
            || (request.resource.data.hookahId is string
                && request.resource.data.hookahId.size() <= 100))
        && (!('tobaccoType' in request.resource.data)
            || (request.resource.data.tobaccoType is string
                && request.resource.data.tobaccoType.size() <= 100))
        // A friend downloads these too, so size is bounded like every other
        // list/map a friend can pull down, not just its element type.
        && (!('flavorIds' in request.resource.data)
            || (request.resource.data.flavorIds is list
                && request.resource.data.flavorIds.size() <= 10))
        && (!('flavorPercentages' in request.resource.data)
            || (request.resource.data.flavorPercentages is map
                && request.resource.data.flavorPercentages.size() <= 10))
        && (!('tobaccoStrength' in request.resource.data)
            || request.resource.data.tobaccoStrength is number)
        && (!('withIce' in request.resource.data) || request.resource.data.withIce is bool)
        && (!('hasLED' in request.resource.data) || request.resource.data.hasLED is bool)
        && (!('hasColoredWater' in request.resource.data)
            || request.resource.data.hasColoredWater is bool)
        && (!('hasAlcohol' in request.resource.data) || request.resource.data.hasAlcohol is bool)
        && (!('hasFruits' in request.resource.data) || request.resource.data.hasFruits is bool)
        // Server time only, matching the acceptedAt idiom on friendships.
        // Optional because a full-document setDoc without merge (what the
        // tests here use) simply omits the field rather than sending a value.
        && (!('createdAt' in request.resource.data)
            || request.resource.data.createdAt == request.time);
      // The claimer deletes the originals once it has copied them, so the dead
      // guest uid is not left holding a second copy of the customer's taste.
      allow delete: if isSignedIn() && (request.auth.uid == uid || hasClaimOn(uid));
    }

    match /users/{uid}/ratings/{comboId} {
      // Same claim-based read as favorites above, for the same reason.
      allow read: if isSignedIn()
        && (request.auth.uid == uid || isFriendOf(uid) || hasClaimOn(uid));
      allow create, update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['comboId', 'label', 'score', 'ratedAt'])
        && request.resource.data.label is string
        && request.resource.data.label.size() <= 200
        // Same shape and bound as the favorites block above.
        && request.resource.data.comboId is string
        && request.resource.data.comboId.size() <= 100
        && request.resource.data.score is int
        && request.resource.data.score >= 1
        && request.resource.data.score <= 5
        // Server time only, matching acceptedAt. Optional: ratingsService
        // always sends it, but nothing here requires a caller to.
        && (!('ratedAt' in request.resource.data)
            || request.resource.data.ratedAt == request.time);
      allow delete: if isSignedIn() && (request.auth.uid == uid || hasClaimOn(uid));
    }

    match /orders/{orderId} {
      // status and total are pinned at creation: update is admin-only, so without
      // this a customer could inject an order that already reads "completed", or
      // an arbitrary total that flows straight into revenue analytics.
      // The uid check is deliberately tolerant. Browsers that loaded the app
      // before the uid deploy still write customerInfo.id, and in a bar those
      // tabs stay open for hours - a strict check turns every one of them into
      // a failed checkout at the till. So: a missing uid is accepted, but a
      // uid that IS present must be the caller's, so nobody can file an order
      // into someone else's history. .get() with a default rather than a bare
      // access, which would raise on the old shape instead of evaluating.
      // Tighten to a required uid once the old bundle is out of circulation.
      allow create: if isSignedIn()
        && request.resource.data.get('customerInfo', {}).get('uid', request.auth.uid)
             == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.total is number
        && request.resource.data.total >= 0;
      allow read: if isAdmin() || (isSignedIn() && ownsOrder());
      allow delete: if isAdmin();

      // hasOnly is what keeps this from becoming a route into status and total.
      allow update: if isAdmin()
        || (isSignedIn() && ownsOrder()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['rating', 'ratedAt'])
            && request.resource.data.rating is int
            && request.resource.data.rating >= 1
            && request.resource.data.rating <= 5
            // Server time only, so a rating cannot carry an arbitrary payload.
            // Optional in the same way acceptedAt is on friendships: an update
            // that changes only `rating` must stay legal.
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['ratedAt'])
                || request.resource.data.ratedAt == request.time))
        // Claiming: the one path by which an order changes hands, for the
        // customer who ordered as a guest and then signed in to an account
        // that already existed. Firebase cannot merge two accounts, so the
        // new session has a different uid and everything the guest created is
        // stranded under the dead one.
        //
        // What makes this safe is hasClaimOn(): possession of a secret held
        // only on the guest's own device, never readable from Firestore. Drop
        // it and this rule reads "any signed-in user may rewrite any order's
        // owner", which is order theft by guessing a document id.
        //
        // The two diffs are what keep it to ownership and nothing else: the
        // outer one pins every other top-level field (status and total stay
        // unreachable, exactly as on the rating branch above), the inner one
        // pins name, id and table inside customerInfo - the bar's own record
        // of who was at which table.
        //
        // .get() defaults throughout rather than bare accesses, because orders
        // written by the pre-uid bundle have a customerInfo with no uid in it
        // and a bare access raises there instead of evaluating - the same trap
        // ownsOrder() documents. hasClaimOn() is last so its document read only
        // happens once the free checks have passed.
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerInfo'])
            && request.resource.data.get('customerInfo', {})
                 .diff(resource.data.get('customerInfo', {}))
                 .affectedKeys().hasOnly(['uid'])
            && request.resource.data.get('customerInfo', {}).get('uid', '') == request.auth.uid
            && hasClaimOn(resource.data.get('customerInfo', {}).get('uid', '')));
    }

    match /menu/{document}             { allow read: if true; allow write: if isAdmin(); }
    match /hookahs/{document}          { allow read: if true; allow write: if isAdmin(); }
    match /tobaccoTypes/{document}     { allow read: if true; allow write: if isAdmin(); }
    match /flavors/{document}          { allow read: if true; allow write: if isAdmin(); }
    match /recommendedMixes/{document} { allow read: if true; allow write: if isAdmin(); }

    // The public QR landing page logs redirects before anonymous sign-in can
    // race, so create stays open - but bounded, since it is the only fully
    // unauthenticated write in the ruleset.
    match /redirects/{document} {
      allow create: if request.resource.data.keys().size() <= 25
        && request.resource.data.target is string
        && request.resource.data.target.size() <= 100;
      allow read: if isAdmin();
    }

    // submitOrder writes a new_order notification as the customer, so create is
    // narrowly permitted - shape-pinned, so a visitor cannot mint arbitrary
    // documents. Admins create too (updateOrderStatus writes order_update).
    // Reads stay admin-only.
    match /notifications/{document} {
      allow create: if isAdmin() || (isSignedIn()
        && request.resource.data.type == 'new_order'
        && request.resource.data.isRead == false
        && request.resource.data.keys().hasOnly(
             ['type','title','message','isRead','orderId','createdAt']));
      allow read, update, delete: if isAdmin();
    }

    // A guest's proof of ownership over what it created before signing in.
    //
    // The device generates a random secret S and keeps it in localStorage;
    // only sha256(S) is ever sent here. Presenting S back is what proves this
    // is the same device, and that is the entire basis on which an order is
    // allowed to change hands - see the claim branch on /orders above.
    //
    // NOTHING CAN READ THIS COLLECTION. get() inside a rule bypasses client
    // read permission, so every check that needs the document still works,
    // but a client that could read one would harvest the secret and the whole
    // scheme degrades to "any signed-in user may take any order".
    match /accountClaims/{anonUid} {
      allow get, list: if false;

      // Your own uid only. Planting a claim over a uid you do not hold is
      // precisely how you would steal that person's orders.
      allow create: if isSignedIn()
        && anonUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['secretHash', 'createdAt'])
        && request.resource.data.secretHash is string
        // Exactly a lower-case sha256 digest. The update rule compares against
        // hashing.sha256(...).toHexString().lower(), so an upper-case or
        // malformed value stored here is a claim nobody can ever take - and,
        // unbounded, this is the same 700KB-string hole label had on favorites.
        && request.resource.data.secretHash.size() == 64
        && request.resource.data.secretHash.matches('^[0-9a-f]+$')
        // Required rather than optional-if-present as elsewhere in this file:
        // this collection is new, so there is no older writer to tolerate.
        // `in` rather than a bare access, which raises on a missing field.
        && 'createdAt' in request.resource.data
        && request.resource.data.createdAt == request.time;

      // Taking the claim: the caller supplies S, the rule recomputes the
      // digest, and only a match names them as the owner.
      //
      // Single use - claimedBy must be unset going in. Without that, a secret
      // that ever leaked would be a permanent skeleton key: whoever holds it
      // could displace each successive owner of those orders in turn.
      //
      // .get() defaults rather than bare accesses so a malformed attempt
      // (claimedBy with no secret, a non-string secret) denies by evaluating
      // instead of raising, matching isAdmin() and ownsOrder().
      allow update: if isSignedIn()
        && resource.data.get('claimedBy', '') == ''
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['claimedBy', 'secret'])
        && request.resource.data.get('claimedBy', '') == request.auth.uid
        && request.resource.data.get('secret', '') is string
        && request.resource.data.get('secret', '').size() <= 200
        && hashing.sha256(request.resource.data.get('secret', '')).toHexString().lower()
             == resource.data.get('secretHash', '');

      // Only the account that took it, so a finished migration can tidy up
      // after itself and nobody can delete a claim out from under one that is
      // still running. An untaken claim is deletable by no one, including the
      // guest that created it - which is deliberate: create allows exactly one
      // per uid, so a delete would be a way to rotate the secret, and a
      // rotatable claim is one an attacker with momentary device access can
      // repoint at themselves.
      allow delete: if isSignedIn()
        && resource.data.get('claimedBy', '') == request.auth.uid;
    }

    // Legacy bcrypt admin store. Sealed; removed once Task 11 lands.
    match /admins/{document} { allow read, write: if false; }

    // Deliberately absent, so default-deny applies: products, sessions and
    // tables. Verified dead - products and sessions are referenced nowhere in
    // src/, and tables only by updateTableStatus, which has no callers.

    // Split from users/{uid} because Firestore has no field-level read
    // security: a friend-read on the user document would hand over the email
    // address, order count and total spend along with the display name.
    // Readable on ANY friendship including pending, so the recipient of a
    // request can see who is asking.
    match /profiles/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || sharesFriendshipWith(uid));
      allow create, update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
        // Bound what a friend has to download. Unvalidated, a 700KB displayName
        // is accepted and then shipped to everyone who opens the profile.
        // null is allowed because Firebase reports "no display name" as null.
        && (!('displayName' in request.resource.data)
            || request.resource.data.displayName == null
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 100))
        // https only, so a javascript: or data:text/html URI can never reach an
        // href or an img src once profile pictures are rendered.
        && (!('photoURL' in request.resource.data)
            || request.resource.data.photoURL == null
            || (request.resource.data.photoURL is string
                && request.resource.data.photoURL.size() <= 500
                && request.resource.data.photoURL.matches('https://.*')))
        // Server time only, matching acceptedAt. Optional: a plain setDoc
        // without merge (as the tests here use) simply omits the field.
        && (!('updatedAt' in request.resource.data)
            || request.resource.data.updatedAt == request.time);
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // One document per relationship. Decline, cancel and unfriend are all a
    // delete - there is no blocklist and no record of a refusal, which is
    // proportionate for a venue with a few hundred customers.
    match /friendships/{pairId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.uids;

      allow create: if isSignedIn()
        // A friendship requires a profile, and anonymous guests never get
        // one - same reasoning as inviteCodes below, reusing its helper.
        // Without this an anonymous guest can create a friendship request
        // directly (after resolving a uid via the open inviteCodes get),
        // and the recipient sees a request from an unattributable "Someone".
        && isRealAccount()
        && request.resource.data.uids.size() == 2
        && request.resource.data.uids[0] < request.resource.data.uids[1]
        && pairId == friendPairId(request.resource.data.uids[0], request.resource.data.uids[1])
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        // pairId joins the two uids with '_', so a uid containing '_' makes the
        // join ambiguous: ("A","B_C") and ("A_B","C") both produce "A_B_C", and
        // whichever pair creates it first grants the other pair access. Firebase
        // Auth uids are 28-char alphanumeric so this is not reachable today, but
        // the separator is load-bearing in a security boundary and the guard is
        // one line. Verified reachable against a rules emulator with synthetic uids.
        && !request.resource.data.uids[0].matches('.*_.*')
        && !request.resource.data.uids[1].matches('.*_.*')
        // Shape-pinned like profiles and notifications. createdAt is permitted
        // but not required: friendsService writes it, the rules tests do not.
        && request.resource.data.keys().hasOnly(['uids', 'requestedBy', 'status', 'createdAt'])
        // Server time only, matching acceptedAt right below.
        && (!('createdAt' in request.resource.data)
            || request.resource.data.createdAt == request.time);

      // Only the other party accepts, and only pending -> accepted. Pinning
      // affectedKeys stops an accept from rewriting who the friendship is
      // between or who asked.
      allow update: if isSignedIn()
        // Same guard as create: accepting is how a guest could gain friend
        // access from the OTHER side of the hole, if a real account ever
        // targeted a guest uid with a request.
        && isRealAccount()
        && request.auth.uid in resource.data.uids
        && resource.data.requestedBy != request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt'])
        // If acceptedAt is written it must be the server's time, not a value the
        // accepting party picked. Optional rather than required, because the
        // rules tests accept without it.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['acceptedAt'])
            || request.resource.data.acceptedAt == request.time);

      allow delete: if isSignedIn() && request.auth.uid in resource.data.uids;
    }

    // Code -> uid, for invite links and QR. get is open to any signed-in user
    // because a code is unguessable; list is denied so the collection cannot be
    // walked to harvest them.
    match /inviteCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        // Without this an anonymous guest can mint a code that resolves to a
        // dead end for whoever scans it.
        && isRealAccount()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'createdAt'])
        // Bound what anyone resolving this code downloads. Same reasoning as
        // the profiles, favorites, ratings and orders blocks above.
        && (!('displayName' in request.resource.data)
            || request.resource.data.displayName == null
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 100))
        // Server time only, matching acceptedAt on friendships.
        && (!('createdAt' in request.resource.data)
            || request.resource.data.createdAt == request.time);
      // Lets the owner refresh a stale displayName without rotating the code.
      // ensureInviteCode only ever creates once, so a name set AFTER the
      // first mint was previously frozen forever - the only fix was Reset
      // link, which invalidates a QR that may already be shared or printed.
      // affectedKeys().hasOnly(['displayName']) is what keeps this narrow:
      // uid is not in the allowed set, so it can never be reassigned to
      // repoint the code at another account (that would be a hijack), and
      // createdAt cannot be forged after the fact either.
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && (!('displayName' in request.resource.data)
            || request.resource.data.displayName == null
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 100));
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // sha256(lowercased email) -> uid, for email search. Opt-in and default-off
    // in the client. get is allowed and list is denied, so someone can confirm
    // an address they already hold but cannot harvest the customer base - which
    // is the part that matters. The document id must be the hash of the
    // CALLER'S OWN email, so nobody can squat an address they do not control.
    match /discoverable/{emailHash} {
      allow get: if isSignedIn();
      allow list: if false;
      // create AND update share one rule, not just create: the document id is
      // deterministic (the hash of your own email), so a repeat setDoc over a
      // surviving document - a retry, a double-tap, or opting in again right
      // after opting out - is evaluated as an update, not a second create.
      // Without allow update that second write was a bare permission-denied
      // with no way to recover.
      // Still theft-proof: emailHash must equal the hash of the CALLER'S OWN
      // email token on every write, so nobody can ever land here to update a
      // document keyed to an email they do not hold - the same guarantee
      // create alone used to provide.
      allow create, update: if isSignedIn()
        // .get() rather than a bare access: a bare one RAISES for an anonymous
        // guest, who has no email claim at all. The denial was already correct,
        // this just makes it evaluate instead of throwing, matching isAdmin()
        // and ownsOrder() above.
        && request.auth.token.get('email', '') != ''
        && emailHash == hashing.sha256(request.auth.token.email.lower()).toHexString().lower()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'displayName'])
        && (!('displayName' in request.resource.data)
            || request.resource.data.displayName == null
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 100));
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
