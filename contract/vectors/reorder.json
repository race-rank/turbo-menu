            "comboId": "custom:x",
            "label": "l",
            "kind": "custom",
            "hookahId": "hk-virginia",
            "tobaccoType": "virginia",
            "flavorIds": [
              "fl-lemon:darkblend"
            ]
          },
          "table": "/table-7"
        },
        "expected": {
          "status": "unavailable",
          "missing": [
            "Lemon"
          ]
        }
      },
      {
        "name": "flavour id without a variant",
        "input": {
          "favorite": {
            "comboId": "custom:x",
            "label": "l",
            "kind": "custom",
            "hookahId": "hk-virginia",
            "tobaccoType": "virginia",
            "flavorIds": [
              "fl-mint"
            ]
          },
          "table": "/table-7"
